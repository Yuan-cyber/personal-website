---
const {
  title,
  titleZh,
  img,
  desc,
  descZh,
  url,
  badge,
  badgeZh,
  tags,
  tagsZh,
  target = "_self",
} = Astro.props;
import { Image } from "astro:assets";
---

<a href={url} target={target} class="block">
  <div
    class="card bg-base-100 overflow-hidden transition ease-in-out hover:shadow-xl hover:scale-[102%] h-full"
  >
    {
      img && (
        <div class="h-50 overflow-hidden">
          <Image
            width={750}
            height={600}
            format="webp"
            src={img}
            alt={title}
            class="w-full h-full object-cover object-top"
          />
        </div>
      )
    }
    <div class="card-body">
      <h2 class="card-title">
        {
          titleZh ? (
            <>
              <span data-i18n-text data-lang="en">
                {title}
              </span>
              <span data-i18n-text data-lang="zh" class="hidden">
                {titleZh}
              </span>
            </>
          ) : (
            title
          )
        }
        {badgeZh ? (
          <>
            <span data-i18n-text data-lang="en" class="contents"><div class="badge badge-secondary shrink-0 whitespace-nowrap">{badge}</div></span>
            <span data-i18n-text data-lang="zh" class="hidden contents"><div class="badge badge-secondary shrink-0 whitespace-nowrap">{badgeZh}</div></span>
          </>
        ) : badge && (
          <div class="badge badge-secondary shrink-0 whitespace-nowrap">{badge}</div>
        )}
      </h2>
      {
        descZh ? (
          <>
            <p data-i18n-text data-lang="en">
              {desc}
            </p>
            <p data-i18n-text data-lang="zh" class="hidden">
              {descZh}
            </p>
          </>
        ) : (
          <p>{desc}</p>
        )
      }
      <div class="card-actions justify-end">
        {tagsZh ? (
          <>
            <span data-i18n-text data-lang="en" class="contents">
              {tags?.map((tag) => <div class="badge badge-outline">{tag}</div>)}
            </span>
            <span data-i18n-text data-lang="zh" class="hidden contents">
              {tagsZh.map((tag) => <div class="badge badge-outline">{tag}</div>)}
            </span>
          </>
        ) : tags?.map((tag) => <div class="badge badge-outline">{tag}</div>)}
      </div>
    </div>
  </div>
</a>
