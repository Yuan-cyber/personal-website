---
// Simple client-side i18n for small text toggles.
// Toggle elements marked with:
//   - data-i18n-text
//   - data-lang="en" | "zh"
---

<div id="lang-switch" class="fixed top-4 right-4 z-50 flex items-center gap-2">
  <button
    type="button"
    data-lang="en"
    class="btn btn-ghost btn-xs"
    aria-label="Switch to English"
  >
    EN
  </button>
  <button
    type="button"
    data-lang="zh"
    class="btn btn-ghost btn-xs"
    aria-label="切换到中文"
  >
    中文
  </button>
</div>

<script>
  const STORAGE_KEY = "site-lang";
  const supported = new Set(["en", "zh"]);

  function guessInitialLang() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved && supported.has(saved)) return saved;
    } catch (_) {}
    const locale = (navigator.language || "en").toLowerCase();
    if (locale.startsWith("zh")) return "zh";
    return "en";
  }

  function setActiveButton(lang) {
    const root = document.getElementById("lang-switch");
    if (!root) return;
    root.querySelectorAll("button[data-lang]").forEach((btn) => {
      const btnLang = btn.getAttribute("data-lang");
      const isActive = btnLang === lang;
      btn.classList.toggle("btn-active", isActive);
      btn.setAttribute("aria-pressed", String(isActive));
    });
  }

  function applyLang(lang) {
    document.querySelectorAll("[data-i18n-text][data-lang]").forEach((el) => {
      const elLang = el.getAttribute("data-lang");
      el.classList.toggle("hidden", elLang !== lang);
    });
    document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
    setActiveButton(lang);
  }

  function initLangSwitcher() {
    const lang = guessInitialLang();
    applyLang(lang);

    const root = document.getElementById("lang-switch");
    if (!root) return;
    root.querySelectorAll("button[data-lang]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const nextLang = btn.getAttribute("data-lang");
        if (!supported.has(nextLang)) return;
        try { localStorage.setItem(STORAGE_KEY, nextLang); } catch (_) {}
        applyLang(nextLang);
      });
    });
  }

  document.addEventListener("astro:page-load", initLangSwitcher);
  document.addEventListener("DOMContentLoaded", initLangSwitcher);
</script>
