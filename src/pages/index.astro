<style>
  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }
  #scroll-chevron {
    animation: scroll-bounce 1.4s ease-in-out infinite;
  }
  #scroll-hint {
    transition: opacity 0.4s ease;
  }
  #scroll-hint.invisible {
    opacity: 0;
    pointer-events: none;
  }

  /* plant groups — no CSS animation, using SVG animateTransform instead */

  /* ── Hero name letters ── */
  .letter {
    display: inline-block;
  }

  /* extra "a" base */
  .extra-a {
    display: inline-block;
    width: 0;
    overflow: hidden;
  }
  .extra-a-yuan {
    animation: extra-a-reveal 2.6s ease-in-out 0.2s both;
  }
  .extra-a-zhao {
    animation: extra-a-reveal 2.6s ease-in-out 0.5s both;
  }

  @keyframes extra-a-reveal {
    0%,
    12% {
      width: 0;
      opacity: 0;
    }
    24% {
      width: 0.6em;
      opacity: 1;
    }
    50% {
      width: 0.6em;
      opacity: 1;
    }
    62% {
      width: 0;
      opacity: 0;
    }
    100% {
      width: 0;
      opacity: 0;
    }
  }

  /* "an" moves upper-left → hold → return */
  .an-group {
    display: inline-block;
    animation: an-move 2.6s cubic-bezier(0.4, 0, 0.2, 1) 0.2s both;
  }
  @keyframes an-move {
    0%,
    16% {
      transform: translate(0, 0);
    }
    44% {
      transform: translate(-0.9em, -0.5em);
    }
    64% {
      transform: translate(-0.9em, -0.5em);
    }
    86% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  /* "ao" moves down → left → return */
  .ao-group {
    display: inline-block;
    animation: ao-move 2.6s cubic-bezier(0.4, 0, 0.2, 1) 0.5s both;
  }
  @keyframes ao-move {
    0%,
    16% {
      transform: translate(0, 0);
    }
    34% {
      transform: translate(0, 0.6em);
    }
    52% {
      transform: translate(-1.3em, 0.6em);
    }
    66% {
      transform: translate(-1.3em, 0.6em);
    }
    86% {
      transform: translate(0, 0);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  /* ── Chinese hero chars ── */
  @keyframes zh-spring-left {
    0% {
      transform: translateX(-1.2em);
      opacity: 0;
    }
    60% {
      transform: translateX(0.08em);
      opacity: 1;
    }
    80% {
      transform: translateX(-0.03em);
    }
    100% {
      transform: translateX(0);
    }
  }
  @keyframes zh-spring-right {
    0% {
      transform: translateX(1.2em);
      opacity: 0;
    }
    60% {
      transform: translateX(-0.08em);
      opacity: 1;
    }
    80% {
      transform: translateX(0.03em);
    }
    100% {
      transform: translateX(0);
    }
  }
  .zh-char-1 {
    animation: zh-spring-left 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
  }
  .zh-char-2 {
    animation: zh-spring-right 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 0.38s both;
  }

  @keyframes letter-bounce-up {
    0%,
    100% {
      translate: 0 0;
    }
    45% {
      translate: 0 -10px;
    }
  }
  @keyframes letter-bounce-down {
    0%,
    100% {
      translate: 0 0;
    }
    45% {
      translate: 0 10px;
    }
  }

  /* ── Accordion track ── */
  #accordion-track {
    width: min(calc(100vw - 48px), calc(1100px - 48px));
  }

  .accordion-card {
    flex: 1;
    min-width: 0;
    transition: flex 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .accordion-card:hover {
    flex: 3;
  }
  .accordion-card:hover .accordion-dot {
    background-color: #7c6354;
  }

  .accordion-desc,
  .accordion-tags {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s ease 0.18s,
      transform 0.25s ease 0.18s;
  }
  .accordion-card:hover .accordion-desc,
  .accordion-card:hover .accordion-tags {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initScrollHint() {
    const hint = document.getElementById("scroll-hint");
    const target = document.getElementById("projects-section");
    if (!hint) return;

    // Click → smooth scroll to projects
    hint.addEventListener("click", () => {
      if (!target) return;
      const y = target.getBoundingClientRect().top + window.scrollY - 72;
      window.scrollTo({ top: y, behavior: "smooth" });
    });
    hint.style.cursor = "pointer";

    // Fade out once user scrolls past hero
    const observer = new IntersectionObserver(
      ([entry]) => {
        hint.classList.toggle("invisible", entry.isIntersecting);
      },
      { threshold: 0.1 },
    );
    if (target) observer.observe(target);
  }

  document.addEventListener("astro:page-load", initScrollHint);
  document.addEventListener("DOMContentLoaded", initScrollHint);

  function initHeroAnimation() {
    const hero = document.getElementById("hero-section");
    const letterAs = document.querySelectorAll<HTMLElement>(".letter-a");
    const aoGroup = document.querySelector<HTMLElement>(".ao-group");
    const zhChar2 = document.querySelector<HTMLElement>(".zh-char-2");
    if (!hero || !letterAs.length) return;

    // Block hover until load animation completes (EN or ZH path)
    let loadDone = false;
    const onLoadEnd = () => {
      loadDone = true;
    };
    aoGroup?.addEventListener("animationend", onLoadEnd, { once: true });
    zhChar2?.addEventListener("animationend", onLoadEnd, { once: true });
    setTimeout(() => {
      loadDone = true;
    }, 3500);

    const allLetters = Array.from(
      document.querySelectorAll<HTMLElement>("#hero-name .letter"),
    );
    let hoverTimer: ReturnType<typeof setInterval> | null = null;

    function pickAndAnimate() {
      // Only animate letters whose parent span is visible (respects EN/ZH toggle)
      const visible = allLetters.filter((el) => el.offsetParent !== null);
      if (visible.length < 2) return;
      visible.forEach((el) => {
        el.style.animation = "";
      });
      const i1 = Math.floor(Math.random() * visible.length);
      let i2;
      do {
        i2 = Math.floor(Math.random() * visible.length);
      } while (i2 === i1);
      visible[i1].style.animation =
        "letter-bounce-up   2.2s cubic-bezier(0.4,0,0.2,1) 0s    1";
      visible[i2].style.animation =
        "letter-bounce-down 2.2s cubic-bezier(0.4,0,0.2,1) 0.18s 1";
    }

    hero.addEventListener("mouseenter", () => {
      if (!loadDone) return;
      pickAndAnimate();
      hoverTimer = setInterval(pickAndAnimate, 2600);
    });

    hero.addEventListener("mouseleave", () => {
      if (hoverTimer) {
        clearInterval(hoverTimer);
        hoverTimer = null;
      }
      allLetters.forEach((el) => {
        el.style.animation = "";
      });
    });
  }

  document.addEventListener("astro:page-load", initHeroAnimation);
  document.addEventListener("DOMContentLoaded", initHeroAnimation);

  function updateAboutLink() {
    const lang = localStorage.getItem("site-lang") || "en";
    const btn = document.getElementById("about-btn") as HTMLAnchorElement | null;
    if (btn) btn.href = lang === "zh" ? "/cv-zh" : "/cv";
  }
  document.addEventListener("astro:page-load", updateAboutLink);
  document.addEventListener("DOMContentLoaded", updateAboutLink);
  function updateContactLink() {
    const lang = localStorage.getItem("site-lang") || "en";
    const btn = document.getElementById("contact-btn") as HTMLAnchorElement | null;
    if (btn) btn.href = lang === "zh" ? "mailto:zhao-yuan-zi@163.com" : "mailto:zhaoyuanren960318@gmail.com";
  }
  document.addEventListener("astro:page-load", updateContactLink);
  document.addEventListener("DOMContentLoaded", updateContactLink);
  document.addEventListener("click", function(e) {
    const b = (e.target as Element | null)?.closest("button[data-lang]");
    if (b) setTimeout(() => { updateAboutLink(); updateContactLink(); }, 10);
  });

  function initPlantVisibility() {
    const svg = document.getElementById("plant-svg");
    const hero = document.getElementById("hero-section");
    if (!svg || !hero) return;
    const obs = new IntersectionObserver(
      ([entry]) => {
        svg.style.visibility = entry.isIntersecting ? "visible" : "hidden";
      },
      { threshold: 0 },
    );
    obs.observe(hero);
  }
  document.addEventListener("astro:page-load", initPlantVisibility);
  document.addEventListener("DOMContentLoaded", initPlantVisibility);

  function initAccordionClick() {
    document
      .querySelectorAll<HTMLAnchorElement>(".accordion-card")
      .forEach((card) => {
        card.addEventListener("pointerdown", (e) => {
          if (e.button === 0 && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
            e.preventDefault();
            window.location.href = card.href;
          }
        });
      });
  }

  document.addEventListener("astro:page-load", initAccordionClick);
  document.addEventListener("DOMContentLoaded", initAccordionClick);
</script>
